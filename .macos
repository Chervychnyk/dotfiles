#!/usr/bin/env bash
set -euo pipefail

# Residual macOS setup that is not representable as scalar non-privileged
# [bootstrap.macos.defaults] entries in mise.toml.
# Review before applying on a fresh laptop.

close_settings() {
  osascript -e 'tell application "System Settings" to quit' 2>/dev/null || true
  osascript -e 'tell application "System Preferences" to quit' 2>/dev/null || true
}

restart_apps() {
  for app in Finder Dock SystemUIServer; do
    killall "$app" >/dev/null 2>&1 || true
  done
}

close_settings
sudo -v

SCREENSHOT_DIR="$HOME/Documents/Screenshots"
mkdir -p "$SCREENSHOT_DIR"

###############################################################################
# System-level and structured defaults                                        #
###############################################################################

# Show hostname details in the login window clock menu.
sudo defaults write /Library/Preferences/com.apple.loginwindow AdminHostInfo HostName

# Keep language/locale explicit. Scalar locale defaults live in mise.toml.
defaults write NSGlobalDomain AppleLanguages -array "en" "ru" "uk"
sudo systemsetup -settimezone "Europe/Kyiv" > /dev/null 2>&1

# Restart automatically if the machine freezes.
# systemsetup emits a harmless InternetServices error on modern macOS; suppress it.
sudo systemsetup -setrestartfreeze on 2>/dev/null

# Display and sleep preferences.
sudo pmset -a displaysleep 15
sudo pmset -c sleep 30
sudo pmset -b displaysleep 5 sleep 10

# Screenshot directory requires HOME interpolation and directory creation.
defaults write com.apple.screencapture location -string "$SCREENSHOT_DIR"

# Finder home path requires HOME interpolation.
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/"

# Desktop icon view settings. Ignore failures on fresh systems.
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:showItemInfo true" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:showItemInfo true" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:showItemInfo true" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:labelOnBottom false" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:arrangeBy grid" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:arrangeBy grid" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:gridSpacing 100" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:gridSpacing 100" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:gridSpacing 100" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:iconSize 80" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:iconSize 80" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:iconSize 80" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true

# Expand useful Get Info panes.
defaults write com.apple.finder FXInfoPanesExpanded -dict \
  General -bool true \
  OpenWith -bool true \
  Privileges -bool true

###############################################################################
# Safari                                                                      #
###############################################################################

# On macOS Sonoma+ Safari's container is sandboxed and defaults write may fail.
# These are applied best-effort; configure manually in Safari if they don't stick.
safari_write() { defaults write com.apple.Safari "$@" 2>/dev/null || true; }
safari_write UniversalSearchEnabled -bool false
safari_write SuppressSearchSuggestions -bool true
safari_write WebKitTabToLinksPreferenceKey -bool true
safari_write com.apple.Safari.ContentPageGroupIdentifier.WebKit2TabsToLinks -bool true
safari_write ShowFullURLInSmartSearchField -bool true
safari_write HomePage -string "about:blank"
safari_write AutoOpenSafeDownloads -bool false
safari_write IncludeDevelopMenu -bool true
safari_write WebKitDeveloperExtrasEnabledPreferenceKey -bool true
safari_write com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true
safari_write WebAutomaticSpellingCorrectionEnabled -bool false
safari_write AutoFillFromAddressBook -bool false
safari_write AutoFillPasswords -bool false
safari_write AutoFillCreditCardData -bool false
safari_write AutoFillMiscellaneousForms -bool false
safari_write WarnAboutFraudulentWebsites -bool true
safari_write WebKitJavaScriptCanOpenWindowsAutomatically -bool false
safari_write com.apple.Safari.ContentPageGroupIdentifier.WebKit2JavaScriptCanOpenWindowsAutomatically -bool false
safari_write InstallExtensionUpdatesAutomatically -bool true

restart_apps

echo "Applied residual macOS defaults. Some changes may still require logout/restart."
