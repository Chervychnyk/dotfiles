{
  "enabled": false,
  "network": {
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "sentry.themindstudios.com",
      "localhost",
      "127.0.0.1"
    ],
    "allowUnixSockets": [
      "~/.colima/default/docker.sock",
      "/var/run/docker.sock",
      "~/.obsidian-cli.sock",
      "/Users/artem/.obsidian-cli.sock"
    ],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg"
    ],
    "allowRead": [
      ".",
      "~/.agents",
      "~/.cache",
      "~/.local/share/mise/installs/pi",
      "~/.pi/agent/agents",
      "~/.pi/agent/skills"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "~/.agents",
      "~/.cache",
      "~/.npm",
      "~/.local/share/nvim",
      "~/.local/state/nvim",
      "~/.pi/cache",
      "~/.pi/agent/skills"
    ]
  }
}
