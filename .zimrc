# Zim modules
# mise manages runtimes; macOS launchd and Keychain manage SSH agents.
zmodule fzf
zmodule magic-enter

# Completion definitions must be on fpath before Zim runs compinit.
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# The Git plugin depends on helpers from Oh My Zsh's Git library.
zmodule ohmyzsh/ohmyzsh --root lib --source git.zsh

# These plugins call compdef while loading, so they must follow completion.
zmodule ohmyzsh/ohmyzsh --root plugins/git
zmodule ohmyzsh/ohmyzsh --root plugins/sudo

# Load widget wrappers in this order, with syntax highlighting last.
# Zoxide is initialized from .zshrc via cache_shell_init rather than as a
# module: kiesman99/zim-zoxide regenerated a shared zoxide.zsh on every startup
# with an unguarded truncate-then-write and then sourced it.
zmodule Aloxaf/fzf-tab
zmodule zsh-users/zsh-autosuggestions
zmodule zdharma-continuum/fast-syntax-highlighting
